<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.cellml.org/cellml/2.0#" name="per_minute">
  <units name="minute">
    <unit units="second" multiplier="60"/>
  </units>
  <!-- 1/60 second^-1, the multiplier is outside of the exponent -->
  <units name="per_minute">
    <unit units="second" exponent="-1" multiplier="0.0166666666666667"/>
  </units>
  <!-- the same units, by reference -->
  <units name="per_minute_by_reference">
    <unit units="minute" exponent="-1"/>
  </units>
  <component name="main">
    <variable name="t" units="minute"/>
    <variable name="x" units="mole" initial_value="1"/>
    <variable name="k" units="per_minute" initial_value="0.1"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply><eq/>
        <apply><diff/><bvar><ci>t</ci></bvar><ci>x</ci></apply>
        <apply><times/><ci>k</ci><ci>x</ci></apply>
      </apply>
    </math>
  </component>
</model>

